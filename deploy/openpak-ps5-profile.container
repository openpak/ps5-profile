[Unit]
Description=OpenPak PS5 user profile (ps5-profile): m.np.playstation.com /api/userProfile, dms.api and legacy profile2

[Container]
ContainerName=openpak-ps5-profile
Image=ghcr.io/openpak/ps5-profile:latest
AutoUpdate=registry
Network=openpak.network
# IP= is assigned with pin-ips.sh --apply.
# Traefik routes Host(m.np.playstation.com) && PathPrefix(/api/userProfile), Host(dms.api.playstation.com)
# and Host(us-prof.np.community.playstation.net) to :8080.
EnvironmentFile=/etc/openpak/.env
Environment=PS5_ADDR=:8080

[Service]
Restart=always

[Install]
WantedBy=default.target
