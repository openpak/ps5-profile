# HTTP listen address (behind Traefik, which terminates TLS).
PS5_ADDR=:8080
# HMAC key shared with ps5-auth, at least 32 bytes. Required.
PS5_TOKEN_KEY=
# OpenPak account core. Both unset: in-memory accounts (dev). Both set: the real core.
# PS5_ACCOUNT_CORE_URL=http://127.0.0.1:7000
# PS5_ACCOUNT_CORE_TOKEN=
# Optional base URL of avatar images; empty means no avatars are listed.
# PS5_PROFILE_AVATAR_URL=
